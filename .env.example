# ============================================================
# Euler · AI Research Navigator — environment example
# Copy this file to `.env` and fill in as needed.
# No API key is required to run the app (uses mock mode).
# ============================================================

# --- LLM provider ---
# Set to "mock" to run with zero configuration (default, no key needed).
# Set to "openrouter" + a real key to enable live AI conversations.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_SMALL_MODEL=openrouter/free
LLM_TIMEOUT_MS=300000

# --- Database ---
DATABASE_URL="file:./dev.db"
